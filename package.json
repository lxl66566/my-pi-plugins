{
  "name": "my-pi-plugins",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for my pi coding agent extensions, published as separate npm packages",
  "license": "MIT",
  "author": "lxl66566",
  "type": "module",
  "scripts": {
    "fmt": "oxfmt",
    "lint": "oxlint . && eslint .",
    "fix": "eslint --fix .",
    "check": "tsc --noEmit",
    "verify": "pnpm fmt:check && pnpm lint && pnpm check && pnpm test",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-regexp": "^3.3.1",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.88.0",
    "simple-git-hooks": "^2.14.0",
    "typebox": "^1.3.37",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,jsonc,md,yml,yaml}": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "eslint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
